#!/bin/bash
XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
for folder in /opt/system/Tools/PortMaster /opt/tools/PortMaster "$XDG_DATA_HOME/PortMaster" /roms/ports/PortMaster; do
    if [ -f "$folder/control.txt" ]; then controlfolder="$folder"; break; fi
done
if [ -z "${controlfolder:-}" ]; then echo 'Open PortMaster to finish setup.'; exit 1; fi
source "$controlfolder/control.txt"
[ -f "$controlfolder/mod_${CFW_NAME}.txt" ] && source "$controlfolder/mod_${CFW_NAME}.txt"
get_controls
GAMEDIR="/${directory#/}/ports/@SLUG@"
cd "$GAMEDIR" || exit 1
mkdir -p conf
exec > >(tee "$GAMEDIR/log.txt") 2>&1
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
trap 'type pm_finish >/dev/null 2>&1 && pm_finish' EXIT
binary="$GAMEDIR/@BINARY@.${DEVICE_ARCH:-aarch64}"
type pm_platform_helper >/dev/null 2>&1 && pm_platform_helper "$binary"
"$binary" --fullscreen --settings "$GAMEDIR/conf/settings.cfg" "$@"
